# Optional server-side RPC override. Prefer this for a hosted release so the
# endpoint is not embedded in the browser bundle. Public fallbacks are used when unset.
MONAD_RPC_URL=https://rpc.monad.xyz

# Optional browser-side wallet transport override. Leave unset unless the URL
# is intentionally public; NEXT_PUBLIC values are bundled into client code.
# NEXT_PUBLIC_MONAD_RPC_URL=https://rpc.monad.xyz

# Optional canonical public origin for metadata and social cards.
# NEXT_PUBLIC_SITE_URL=https://monmix.vercel.app

# Safety gate. Keep false unless the owner has reviewed a final simulation and explicitly approved a real trade.
NEXT_PUBLIC_ENABLE_MAINNET_EXECUTION=false
